#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"

// SwiftyTesseract 3.1.x has no ios-arm64-simulator slice. Force the Runner target to skip
// the arm64 simulator slice so Apple Silicon Macs link against x86_64 via Rosetta.
// See the Podfile post_install hook for the matching exclusion on Pod targets.
EXCLUDED_ARCHS[sdk=iphonesimulator*] = arm64
