#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Generated.xcconfig"

// SwiftyTesseract 3.1.3 has no ios-arm64-simulator slice. Force the Runner target to skip
// the arm64 simulator slice so Apple Silicon Macs link against x86_64 via Rosetta.
EXCLUDED_ARCHS[sdk=iphonesimulator*] = arm64
